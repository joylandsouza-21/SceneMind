# ==============================================================================
# Sheela AI - Video Semantic Indexing & Clipping Configuration
# ==============================================================================

# Gemini AI Key (leave blank or fill with your Gemini API key)
# When left blank or in demo mode, the built-in Intelligent AI Simulator is used.
GEMINI_API_KEY=

# Gemini Models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Vector Store Provider: "embedded" (default, zero config) or "pinecone"
VECTOR_STORE_PROVIDER=embedded
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_ENVIRONMENT=

# Storage Provider: "local" or "s3"
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Database
DATABASE_URL=file:./data/sheela.db

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
